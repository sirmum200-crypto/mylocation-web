rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // سجل الاسم: قراءة للجميع، والكتابة مفتوحة لتغيير الاسم
    match /profile/{profileId} {
      allow read: if true;
      allow write: if true;
    }

    // أي شيء آخر ممنوع
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
